digraph {
	nodesep=0.12 rankdir=LR ranksep=0.5
	node [fontsize=11]
	root [label="BISOS-Digital-Ecosystem-Skills
(BISOS / Blee / ByStar; Claude loads)
(build your own equivalent)" fillcolor=thistle fontsize=13 shape=ellipse style="filled,bold"]
	ecoAuthorship [label="authorship model" color=gray40 fontsize=11 shape=box style=dashed]
	root -> ecoAuthorship [arrowhead=none color=gray40]
	"comeega-authorship" [label="comeega-authorship" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoAuthorship -> "comeega-authorship" [arrowhead=none color=gray40]
	"dblock-authoring" [label="dblock-authoring" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoAuthorship -> "dblock-authoring" [arrowhead=none color=gray40]
	ecoPycs [label="PyCS commands" color=gray40 fontsize=11 shape=box style=dashed]
	root -> ecoPycs [arrowhead=none color=gray40]
	"writing-cs-commands" [label="writing-cs-commands" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoPycs -> "writing-cs-commands" [arrowhead=none color=gray40]
	"icm-to-pycs-conversion" [label="icm-to-pycs-conversion" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoPycs -> "icm-to-pycs-conversion" [arrowhead=none color=gray40]
	ecoSeeded [label="seeded CS" color=gray40 fontsize=11 shape=box style=dashed]
	root -> ecoSeeded [arrowhead=none color=gray40]
	"seeded-cs-commands" [label="seeded-cs-commands" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSeeded -> "seeded-cs-commands" [arrowhead=none color=gray40]
	"spread-seeded-cs-commands" [label="spread-seeded-cs-commands" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSeeded -> "spread-seeded-cs-commands" [arrowhead=none color=gray40]
	"walkable-tree-planting" [label="walkable-tree-planting" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSeeded -> "walkable-tree-planting" [arrowhead=none color=gray40]
	"cbm-authorship" [label="cbm-authorship" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSeeded -> "cbm-authorship" [arrowhead=none color=gray40]
	"sysd-pcs-authorship" [label="sysd-pcs-authorship" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSeeded -> "sysd-pcs-authorship" [arrowhead=none color=gray40]
	"configfile-pattern" [label="configfile-pattern" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSeeded -> "configfile-pattern" [arrowhead=none color=gray40]
	"sbom-authoring" [label="sbom-authoring" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSeeded -> "sbom-authoring" [arrowhead=none color=gray40]
	ecoCapability [label="capability packages" color=gray40 fontsize=11 shape=box style=dashed]
	root -> ecoCapability [arrowhead=none color=gray40]
	"cbm-package-authorship" [label="cbm-package-authorship" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoCapability -> "cbm-package-authorship" [arrowhead=none color=gray40]
	ecoLookups [label=lookups color=gray40 fontsize=11 shape=box style=dashed]
	root -> ecoLookups [arrowhead=none color=gray40]
	"banna-lookup" [label="banna-lookup" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoLookups -> "banna-lookup" [arrowhead=none color=gray40]
	ecoSites [label="web sites" color=gray40 fontsize=11 shape=box style=dashed]
	root -> ecoSites [arrowhead=none color=gray40]
	"astro-site-authorship" [label="astro-site-authorship" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSites -> "astro-site-authorship" [arrowhead=none color=gray40]
	"bx-pals-web-site" [label="bx-pals-web-site" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSites -> "bx-pals-web-site" [arrowhead=none color=gray40]
	"bs-pals-web-edit" [label="bs-pals-web-edit" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoSites -> "bs-pals-web-edit" [arrowhead=none color=gray40]
	ecoBlee [label=Blee color=gray40 fontsize=11 shape=box style=dashed]
	root -> ecoBlee [arrowhead=none color=gray40]
	"blee-pkg-authorship" [label="blee-pkg-authorship" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoBlee -> "blee-pkg-authorship" [arrowhead=none color=gray40]
	"bs-blee-emacs-server" [label="bs-blee-emacs-server" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoBlee -> "bs-blee-emacs-server" [arrowhead=none color=gray40]
	ecoPackaging [label="packaging and docs" color=gray40 fontsize=11 shape=box style=dashed]
	root -> ecoPackaging [arrowhead=none color=gray40]
	"bisos-pip-setup-py" [label="bisos-pip-setup-py" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoPackaging -> "bisos-pip-setup-py" [arrowhead=none color=gray40]
	"bisos-pip-release" [label="bisos-pip-release" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoPackaging -> "bisos-pip-release" [arrowhead=none color=gray40]
	"readme-authorship" [label="readme-authorship" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoPackaging -> "readme-authorship" [arrowhead=none color=gray40]
	"blee-panel-authorship" [label="blee-panel-authorship" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoPackaging -> "blee-panel-authorship" [arrowhead=none color=gray40]
	"graphviz-authoring" [label="graphviz-authoring" fillcolor=lightcyan shape=box style="filled,rounded"]
	ecoPackaging -> "graphviz-authoring" [arrowhead=none color=gray40]
	"spread-seeded-cs-commands" -> "seeded-cs-commands" [color=purple constraint=false penwidth=1.4 style=dotted]
	"walkable-tree-planting" -> "seeded-cs-commands" [color=purple constraint=false penwidth=1.4 style=dotted]
	"walkable-tree-planting" -> "spread-seeded-cs-commands" [color=purple constraint=false penwidth=1.4 style=dotted]
	"cbm-authorship" -> "spread-seeded-cs-commands" [color=purple constraint=false penwidth=1.4 style=dotted]
	"icm-to-pycs-conversion" -> "writing-cs-commands" [color=purple constraint=false penwidth=1.4 style=dotted]
	"cbm-package-authorship" -> "cbm-authorship" [color=purple constraint=false penwidth=1.4 style=dotted]
	"cbm-package-authorship" -> "sysd-pcs-authorship" [color=purple constraint=false penwidth=1.4 style=dotted]
	"cbm-package-authorship" -> "banna-lookup" [color=purple constraint=false penwidth=1.4 style=dotted]
	"blee-pkg-authorship" -> "comeega-authorship" [color=purple constraint=false penwidth=1.4 style=dotted]
	"cbm-authorship" -> "walkable-tree-planting" [label=" if walked " color=plum3 constraint=false fontcolor=purple fontsize=9 penwidth=1.4 style=dotted]
	"astro-site-authorship" -> "bx-pals-web-site" [label=" if PALS " color=plum3 constraint=false fontcolor=purple fontsize=9 penwidth=1.4 style=dotted]
	{
		rank=same
		root
		legend [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>lives in</B></TD><TD><B>seen by</B></TD></TR><TR><TD BGCOLOR="lightcyan">mother/_skills/</TD><TD>every project: one shared set,<BR/>all activities</TD></TR><TR><TD COLSPAN="2"><FONT COLOR="purple">dotted arrow = load the target skill first</FONT></TD></TR></TABLE>> fontsize=10 shape=plaintext]
	}
	root -> legend [style=invis]
}
